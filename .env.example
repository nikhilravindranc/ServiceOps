# Local SQLite file (relative to prisma/schema.prisma). For production use a Postgres URL and set the provider in schema.prisma.
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Optional social sign-in. Buttons only work when these are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Email delivery. Leave empty to log emails to the server console instead.
EMAIL_FROM="ServiceOps <no-reply@example.com>"
RESEND_API_KEY=""
# Public base URL used in emailed links.
APP_URL="http://localhost:3100"
# Demo administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
